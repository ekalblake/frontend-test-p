{
	"extends": "./tsconfig.app.json",
	"compilerOptions": {
		"paths": {
			"@/*": ["src/*"],
			"tests/*": ["tests/*"]
		},
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
		"types": ["vite/client", "vitest"]
	},
	"include": ["tests/**/*.ts", "src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"]
}
